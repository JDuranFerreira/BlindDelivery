/* Item HUD layout only. Look-and-feel lives in UI/Theme/Common.uss. */

.safe-area {
    flex-grow: 1;
    pointer-events: none;
}

.status-panel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 108px;
    padding: 8px 10px;
}

.hud-phase {
    font-size: 11px;
    min-height: 14px;
    color: rgb(240, 198, 116);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.hud-phase.preparing {
    color: rgb(120, 220, 160);
}

.stats-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
}

.tool-stat {
    color: rgb(120, 200, 245);
}

.hud-stat {
    min-width: 0;
    min-height: 16px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.points-track {
    margin-top: 6px;
}

.points-fill {
    background-color: rgb(240, 198, 116);
}

.cooldown-track {
    margin-top: 6px;
}

.cooldown-label {
    min-height: 16px;
    margin-top: 2px;
}

.toolbar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 56px;
    flex-direction: row;
    align-items: stretch;
    pointer-events: auto;
}

.tool-button {
    width: 36px;
    height: 48px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-right: 3px;
    margin-left: 3px;
    padding: 3px;
    overflow: hidden;
}

.tool-icon {
    width: 100%;
    height: 100%;
}

.tool-cooldown {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 3px;
    background-color: rgb(240, 140, 80);
}

.tool-button.unavailable {
    background-color: rgb(20, 24, 31);
}

.tool-button.unavailable .tool-icon {
    opacity: 0.3;
}

.hint {
    position: absolute;
    bottom: 62px;
    left: 0;
    right: 0;
    padding: 0 6px;
    font-size: 9px;
    white-space: normal;
    color: rgb(170, 185, 200);
    -unity-text-align: middle-center;
}
