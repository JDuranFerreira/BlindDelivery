<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="ResultRoot" class="result-root">
        <ui:VisualElement name="SafeArea" class="safe-area result-safe-area">
            <ui:VisualElement name="ResultPanel" class="result-panel hud-panel">
                <ui:Label name="ResultTitle" text="DELIVERED" class="result-title hud-title" />
                <ui:Label name="Stars" text="3 / 3 STARS" class="result-stars" />
                <ui:Label name="Bonus" text="" class="result-bonus" />
                <ui:Label name="Score" text="Score  0" class="result-score" />
                <ui:Label name="Time" text="Time  0.0s" class="result-score result-time" />
                <ui:Label name="Best" text="Best  0.0s" class="result-score result-time" />
                <ui:Button name="Replay" text="REPLAY" class="hud-button result-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
